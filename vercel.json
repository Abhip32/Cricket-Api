{
  "version": 2,
  "env": {
    "AWS_LAMBDA_JS_RUNTIME": "nodejs20.x"
  },
  "build": {
    "env": {
      "AWS_LAMBDA_JS_RUNTIME": "nodejs20.x"
    }
  },
  "builds": [
    {
      "src": "./index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "memory": 1024
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}
